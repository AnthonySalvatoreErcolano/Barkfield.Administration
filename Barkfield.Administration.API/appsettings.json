{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "ConnectionString": ""
  },

  "JwtSettings": {
    "Secret": "",
    "Issuer": "Barkfield.Administration.API",
    "Audience": "Barkfield.Administration.Admin",
    "ExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7
  },

  "Cors": {
    "//": "The admin site's origin(s). Must be listed explicitly — a browser will not send the refresh cookie to a wildcard origin.",
    "AllowedOrigins": []
  },

  "Cookies": {
    "//": "SameSite must be None when the admin site and the API are on different domains (e.g. Vercel + Azure), otherwise the browser never sends the refresh cookie and every session silently expires. None requires Secure, which requires HTTPS.",
    "SameSite": "None",
    "Secure": true,
    "Domain": ""
  },

  "Routific": {
    "ApiKey": "",
    "BaseUrl": "https://api.routific.com"
  },

  "Monday": {
    "ApiToken": "",
    "BaseUrl": "https://api.monday.com/v2",
    "BoardId": ""
  },

  "Square": {
    "AccessToken": "",
    "Environment": "Sandbox",
    "LocationId": "",
    "WebhookSignatureKey": ""
  },

  "Astro": {
    "ApiKey": "",
    "BaseUrl": ""
  }
}
